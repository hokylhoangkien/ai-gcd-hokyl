{
  "seed": 3,
  "data": {
    "manifest": "data/processed/planogram_manifest.csv",
    "image_root": "data/processed/planogram_crops",
    "attributes": [
      "brand",
      "product_line",
      "variant",
      "volume",
      "pack_count",
      "packaging"
    ],
    "num_workers": 8,
    "batch_size": 32,
    "eval_batch_size": 128,
    "balance_labeled_unlabeled": true,
    "horizontal_flip": false,
    "validation_splits": [
      "val"
    ]
  },
  "model": {
    "clip_model": "ViT-B-16",
    "clip_pretrained": "laion2b_s34b_b88k",
    "projection_dim": 256,
    "reliability_hidden_dim": 128,
    "fusion_mode": "simple",
    "freeze_text_encoder": true,
    "freeze_visual_until_epoch": 5
  },
  "train": {
    "epochs": 100,
    "learning_rate": 0.0001,
    "min_learning_rate": 1e-06,
    "weight_decay": 0.0001,
    "temperature": 0.1,
    "pseudo_label_threshold": 0.8,
    "pseudo_label_warmup_epochs": 20,
    "contrastive_temperature": 0.1,
    "attribute_confidence_threshold": 0.7,
    "lambda_supervised": 1.0,
    "lambda_consistency": 1.0,
    "lambda_distillation": 1.0,
    "warmup_teacher_temperature": 0.07,
    "teacher_temperature": 0.04,
    "student_temperature": 0.1,
    "teacher_temperature_warmup_epochs": 30,
    "lambda_instance_contrastive": 1.0,
    "lambda_supervised_contrastive": 0.35,
    "lambda_dual_branch": 1.0,
    "lambda_cico": 1.0,
    "lambda_sdl": 0.0,
    "lambda_adl": 0.0,
    "lambda_hierarchy": 0.0,
    "debiased_pseudo_threshold": 0.95,
    "hierarchy_levels": 3,
    "hierarchy_refresh_interval": 5,
    "hierarchy_kmeans_iterations": 20,
    "cico_start_epoch": 5,
    "cico_warmup_epochs": 10,
    "sdl_start_epoch": 5,
    "sdl_warmup_epochs": 10,
    "adl_start_epoch": 10,
    "adl_warmup_epochs": 10,
    "hierarchy_start_epoch": 5,
    "hierarchy_warmup_epochs": 10,
    "conflict_start_epoch": 5,
    "conflict_warmup_epochs": 10,
    "lambda_entropy": 0.05,
    "lambda_attribute": 0.0,
    "lambda_conflict": 0.0,
    "lambda_calibration": 0.0,
    "amp": true,
    "gradient_clip_norm": 5.0
  },
  "output_dir": "outputs/planogram/get_adapted/seed_3",
  "resume": null
}